{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CYBERTRACK: Backend API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "CYBERTRACK: Stop Server"
    },
    {
      "name": "CYBERTRACK: Frontend (Vite dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "CYBERTRACK: Run Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "CYBERTRACK: Full App (dev, hot reload)",
      "configurations": [
        "CYBERTRACK: Backend API (debug)",
        "CYBERTRACK: Frontend (Vite dev)"
      ],
      "stopAll": true
    }
  ]
}
