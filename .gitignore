# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Environment
.env
.venv/
venv/

# Data (generated at runtime)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Frontend build / deps
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Secrets — never commit
*.key
*.pem

# Runtime / local-only artifacts (never push)
logs/
*.log
cloudflared.exe
.server.pid
PUBLIC_URL.txt
verify_public.py
