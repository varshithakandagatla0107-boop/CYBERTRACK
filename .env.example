# CYBERTRACK Environment Variables
# Copy this file to .env and fill in values
# Environment variables take precedence over .env file

# --- Database ---
# SQLite path (absolute or relative to project root)
# Examples:
#   CYBERTRACK_DB=backend/data/cybertrack.db
#   CYBERTRACK_DB=sqlite:///backend/data/cybertrack.db
#   CYBERTRACK_DB=sqlite:////absolute/path/to/cybertrack.db
# PostgreSQL is NOT supported in this release:
#   CYBERTRACK_DB=postgresql+asyncpg://user:pass@host:5432/cybertrack  # REJECTED
CYBERTRACK_DB=backend/data/cybertrack.db

# --- Authentication ---
# JWT secret (MUST be >= 32 bytes in production mode)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In demo mode (CYBERTRACK_MODE=demo), a random secret is generated per process
CYBERTRACK_JWT_SECRET=prototype-demo-secret-change-me-in-production

# JWT algorithm (HS256 only)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (default: 480 = 8 hours)
# Deprecated alias: CYBERTRACK_JWT_EXPIRE (still works with warning)
CYBERTRACK_JWT_EXPIRE_MINUTES=480

# --- Application Mode ---
# demo: random JWT secret per process, demo users seeded, verbose logs
# production: requires strong CYBERTRACK_JWT_SECRET, no demo users, strict security
# Values: demo | production
CYBERTRACK_MODE=demo

# --- File Upload ---
# Maximum upload size in MB
MAX_UPLOAD_MB=25

# --- Frontend ---
# Frontend dev server URL (for CORS)
FRONTEND_URL=http://localhost:5173

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO